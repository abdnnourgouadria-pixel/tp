@startuml
|Librarian|
start
:Scan the returned copy;
|System|
:Identify the loan;
if (copy on loan?) then (yes)
else (no)
  :Display error "copy not on loan";
  stop
endif
:Close the loan;
if (returned late?) then (yes)
  :Suspend the member\n(extension point: late return);
else (no)
endif
if (copy reserved?) then (yes)
  :Keep the copy aside;
  :Notify the member who reserved it;
else (no)
  :Put the copy back in available stock;
endif
:Print the receipt;
stop
@enduml
